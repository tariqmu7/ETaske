rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helpers ──────────────────────────────────────────────────────────────
    // status/role live in the users doc (no backend = no custom claims), so role
    // gating costs one cached get() of the caller's own user doc per request.
    function isSignedIn() {
      return request.auth != null;
    }
    function isAdminEmail() {
      // The BOOTSTRAP admin only — matches src/App.tsx, keep both in sync. It
      // lets the first account in and self-heals that account's Admin role on
      // every login, so the app can never be left with nobody to approve users.
      return isSignedIn() && request.auth.token.email == 'tarekmoh123@gmail.com';
    }
    function userData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }
    function isApproved() {
      // Missing user doc -> userData() errors -> denies (intended: not approved).
      return isAdminEmail() || (isSignedIn() && userData().status == 'Approved');
    }
    function isAdmin() {
      // Any Approved user whose role is Admin (set in the Users screen by an
      // existing admin), plus the bootstrap email. Queue A3a: a second admin
      // must be able to manage accounts, not just see the Users screen.
      return isAdminEmail() ||
        (isSignedIn() && userData().status == 'Approved' && userData().role == 'Admin');
    }
    function isManagerOrAdmin() {
      return isAdminEmail() ||
        (isSignedIn() && userData().status == 'Approved' &&
         userData().role in ['Manager', 'Admin']);
    }

    // Default: deny everything
    match /{document=**} {
      allow read, write: if false;
    }

    // ─── Users ────────────────────────────────────────────────────────────────
    // Any signed-in user can read profiles (assignment lists; own pending status
    // before approval). Reading is intentionally broad — see RULES-NOTES.md.
    match /users/{userId} {
      allow read: if isSignedIn();

      // Self-signup is only allowed as a Pending Employee. The hardcoded admin
      // may bootstrap its own Admin/Approved doc. This blocks an attacker from
      // self-granting Admin/Approved at create time.
      allow create: if isSignedIn() && request.auth.uid == userId &&
        !request.resource.data.keys().hasAny(['telegramChatId', 'fcmToken']) && (
        isAdminEmail() ||
        (request.resource.data.status == 'Pending' &&
         request.resource.data.role == 'Employee')
      );

      // An admin (bootstrap email or an Approved role-Admin) may change anything
      // (approve/reject/promote). Creating a doc as Admin stays email-only. A user may edit their
      // own profile but may NOT change their own role or status — closes the
      // self-escalation hole (a Pending user promoting itself to Admin/Approved).
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId &&
         request.resource.data.role == resource.data.role &&
         request.resource.data.status == resource.data.status &&
         keepsOrDrops('telegramChatId') && keepsOrDrops('fcmToken'))
      );

      // The contact ids moved to private/contact (queue A3b). An old copy on
      // this public doc may be kept or removed by its owner, never set/changed.
      function keepsOrDrops(field) {
        return !(field in request.resource.data) ||
          request.resource.data[field] == resource.data.get(field, null);
      }

      allow delete: if isAdmin();

      // Private contact ids (queue A3b): { telegramChatId?, fcmToken? }. The
      // directory above is readable by everyone, so these live here, readable
      // by the OWNER only; the Apps Script reads them as the script owner to
      // send pushes/Telegram. The owner may set their push token, but may only
      // REMOVE the chat id — the script writes it when a Telegram link
      // completes, so nobody can attach someone else's chat to their account.
      match /private/{docId} {
        allow read, delete: if isSignedIn() && request.auth.uid == userId;
        allow create, update: if isSignedIn() && request.auth.uid == userId &&
          docId == 'contact' &&
          request.resource.data.keys().hasOnly(['telegramChatId', 'fcmToken']) &&
          (!('fcmToken' in request.resource.data) ||
            (request.resource.data.fcmToken is string && request.resource.data.fcmToken.size() <= 4096)) &&
          (!('telegramChatId' in request.resource.data) ||
            (resource != null && resource.data.get('telegramChatId', null) == request.resource.data.telegramChatId));
      }
    }

    // ─── Serial-number counters ───────────────────────────────────────────────
    // tasks/--stats-- and correspondences/--stats-- (src/lib/counters.ts).
    // Increment-only: cannot be reset, decremented, skewed, or deleted.
    match /tasks/--stats-- {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == 1;
      allow update: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
    match /correspondences/--stats-- {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == 1;
      allow update: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }
    match /projects/--stats-- {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == 1;
      allow update: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    match /opportunities/--stats-- {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == 1;
      allow update: if isApproved() &&
        request.resource.data.keys().hasOnly(['value']) &&
        request.resource.data.value == resource.data.value + 1;
      allow delete: if false;
    }

    // ─── Correspondences ──────────────────────────────────────────────────────
    match /correspondences/{id} {
      allow read: if isApproved();
      allow create: if isApproved() && id != '--stats--' &&
        request.resource.data.userId == request.auth.uid;
      allow update: if isApproved() && id != '--stats--' && (
        isManagerOrAdmin() || resource.data.userId == request.auth.uid
      );
      allow delete: if isManagerOrAdmin() && id != '--stats--';
    }

    // ─── Tasks ────────────────────────────────────────────────────────────────
    // A task may be PRIVATE (isPrivate == true): readable and writable ONLY by
    // its owner — the assignee (assignedToId) — not managers, not admin, not the
    // manager who assigned it. PUBLIC tasks (isPrivate false/absent) keep the
    // shared-org-board behaviour. Old docs without the field count as public via
    // .get(..., false). Because rules are guards (not row filters), clients must
    // read tasks via the public-OR-mine split in src/lib/taskVisibility.ts.
    match /tasks/{taskId} {
      function taskIsPrivate(data) { return data.get('isPrivate', false) == true; }
      function ownsTask(data)      { return data.assignedToId == request.auth.uid; }
      // A collaborator is explicitly added to the task and is treated like a
      // co-owner: can read & edit even when the task is private.
      function isCollaborator(data) {
        return request.auth.uid in data.get('collaboratorIds', []);
      }

      allow read: if isApproved() &&
        (!taskIsPrivate(resource.data) || ownsTask(resource.data) || isCollaborator(resource.data));
      allow create: if isApproved() && taskId != '--stats--' &&
        request.resource.data.assignedById == request.auth.uid;
      // Owner and collaborators can always edit. Other non-owners (managers/admin
      // or the assigner) may only edit PUBLIC tasks — this also stops a manager
      // from flipping someone else's private task to public to read it. A
      // non-collaborator cannot self-add to a private task: to write at all they
      // must already be owner/collaborator.
      allow update: if isApproved() && taskId != '--stats--' && (
        ownsTask(resource.data) ||
        isCollaborator(resource.data) ||
        (!taskIsPrivate(resource.data) &&
          (isManagerOrAdmin() || resource.data.assignedById == request.auth.uid))
      );
      // Private tasks: owner-only delete. Public tasks keep the prior
      // manager/admin-only delete (the assignee cannot delete a public task).
      allow delete: if isApproved() && taskId != '--stats--' && (
        (taskIsPrivate(resource.data) && ownsTask(resource.data)) ||
        (!taskIsPrivate(resource.data) && isManagerOrAdmin())
      );
    }

    // ─── Milestones ───────────────────────────────────────────────────────────
    // No teamId on milestones; scope by author or the parent task's assignee.
    match /milestones/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.addedById == request.auth.uid;
      allow update, delete: if isApproved() && (
        isManagerOrAdmin() ||
        resource.data.addedById == request.auth.uid ||
        get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.assignedToId == request.auth.uid ||
        request.auth.uid in get(/databases/$(database)/documents/tasks/$(resource.data.taskId)).data.get('collaboratorIds', [])
      );
    }

    // ─── Projects ─────────────────────────────────────────────────────────────
    // Shared org board (consistent with tasks/correspondences trust boundary in
    // RULES-NOTES.md): any Approved user may read and manage projects and all of
    // their related records (contracts tree, subcontracts, financials, updates).
    match /projects/{id} {
      allow read: if isApproved();
      allow create: if isApproved() && id != '--stats--' &&
        request.resource.data.userId == request.auth.uid;
      allow update, delete: if isApproved() && id != '--stats--';
    }
    match /projectContracts/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved();
    }
    match /projectSubcontracts/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved();
    }
    match /projectFinancials/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved();
    }
    match /projectUpdates/{id} {
      allow read: if isApproved();
      allow create, update, delete: if isApproved();
    }

    // ─── Opportunities (tenders / bids) ───────────────────────────────────────
    // Same shared org board as projects (RULES-NOTES.md): any Approved user may
    // read and manage opportunities and their follow-ups, milestones and
    // outcome feedback. Deleting an opportunity is manager/admin only — a lost
    // bid and its loss analysis are the record the analytics view is built on.
    //
    // Offer sign-off (queue D10, src/lib/offerApproval.ts — keep the two in
    // step): only a manager may write an "approved" sign-off, and an employee
    // may not move a bid from a pre-send stage to Submitted / Under Evaluation /
    // Won unless it carries an approval for the bid's price as saved.
    function passesOfferSignOff() {
      let before = resource.data;
      let after = request.resource.data;
      let a = after.get('approval', {});
      let noSelfApproval = a.get('status', '') != 'approved' || a == before.get('approval', {});
      let gated = before.get('stage', '') in ['Identified', 'Prequalification', 'Bid Preparation'] &&
        after.get('stage', '') in ['Submitted', 'Under Evaluation', 'Won'];
      let signedOff = a.get('status', '') == 'approved' &&
        a.get('amount', null) == after.get('estimatedValue', null) &&
        a.get('currency', '') == after.get('currency', '');
      return isManagerOrAdmin() || (noSelfApproval && (!gated || signedOff));
    }
    match /opportunities/{id} {
      allow read: if isApproved();
      allow create: if isApproved() && id != '--stats--' &&
        request.resource.data.userId == request.auth.uid &&
        (isManagerOrAdmin() || request.resource.data.get('approval', {}).get('status', '') != 'approved');
      allow update: if isApproved() && id != '--stats--' && passesOfferSignOff();
      allow delete: if isManagerOrAdmin() && id != '--stats--';
    }
    match /opportunityFollowUps/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isApproved() && (
        isManagerOrAdmin() || resource.data.authorId == request.auth.uid
      );
    }
    match /opportunityMilestones/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.addedById == request.auth.uid;
      allow update, delete: if isApproved();
    }
    match /opportunityFeedback/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.authorId == request.auth.uid;
      allow update, delete: if isApproved() && (
        isManagerOrAdmin() || resource.data.authorId == request.auth.uid
      );
    }

    // ─── Meetings (queue D5) ───────────────────────────────────────────────────
    // Agenda, minutes and action points, one doc per meeting. Readable by any
    // Approved member (same shared-org trust boundary as projects — see
    // RULES-NOTES.md). The person who sets it up must be the writer; the
    // creator, anyone attending, or a manager/admin may edit it, and nobody may
    // re-assign who created it. Delete: the creator or a manager/admin. Tasks
    // made from action points are ordinary tasks under the tasks rules.
    match /meetings/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.createdById == request.auth.uid;
      allow update: if isApproved() &&
        request.resource.data.createdById == resource.data.createdById && (
          isManagerOrAdmin() ||
          resource.data.createdById == request.auth.uid ||
          request.auth.uid in resource.data.get('attendeeIds', [])
        );
      allow delete: if isApproved() && (
        isManagerOrAdmin() || resource.data.createdById == request.auth.uid
      );
    }

    // ─── Notifications ────────────────────────────────────────────────────────
    // Readable only by the recipient (or admin). Any approved user may create a
    // notification addressed to another user. The recipient may only flip `read`.
    match /notifications/{id} {
      allow read: if isApproved() && (
        isAdmin() || resource.data.forUserId == request.auth.uid
      );
      allow create: if isApproved();
      allow update: if isApproved() &&
        resource.data.forUserId == request.auth.uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if isAdmin();
    }

    // ─── Announcements ────────────────────────────────────────────────────────
    // Department broadcast. Readable by any Approved member (no per-record
    // isolation — consistent with the shared-org trust boundary in
    // RULES-NOTES.md; department scoping is applied client-side). Any Approved
    // user may post one authored by themselves. A non-author may only append
    // themselves to `readBy` (mark-as-seen); the author or a manager/admin may
    // edit or delete it.
    match /announcements/{id} {
      allow read: if isApproved();
      allow create: if isApproved() &&
        request.resource.data.authorId == request.auth.uid;
      allow update: if isApproved() && (
        isManagerOrAdmin() ||
        resource.data.authorId == request.auth.uid ||
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['readBy'])
      );
      allow delete: if isApproved() && (
        isManagerOrAdmin() || resource.data.authorId == request.auth.uid
      );
    }

    // ─── Chat Messages ────────────────────────────────────────────────────────
    match /messages/{id} {
      allow read: if isSignedIn() && (
        request.auth.uid in resource.data.participants ||
        request.auth.uid == resource.data.receiverId ||
        request.auth.uid == resource.data.senderId
      );
      allow create: if isSignedIn() && request.auth.uid in request.resource.data.participants;
      // Allow receiver to mark as read (and stamp readAt for the seen receipt)
      allow update: if isSignedIn() && request.auth.uid == resource.data.receiverId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt']);
      allow delete: if false;
    }
  }
}
// Force upload by changing hash 2
